<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-first Unicode Studio palette -->
    <style name="Theme" parent="Theme.AppCompat">
        <item name="colorPrimary">#1B2435</item>
        <item name="colorPrimaryDark">#111827</item>
        <item name="colorAccent">#A78BFA</item>
        <item name="colorControlActivated">#A78BFA</item>
        <item name="colorControlHighlight">#33A78BFA</item>
        <item name="colorButtonNormal">#344158</item>
        <item name="android:colorAccent">#A78BFA</item>
        <item name="android:windowBackground">#111827</item>
        <item name="android:colorBackground">#111827</item>
        <item name="android:textColorPrimary">#F8FAFC</item>
        <item name="android:textColorSecondary">#CBD5E1</item>
        <item name="android:statusBarColor">#111827</item>
        <item name="android:navigationBarColor">#111827</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="backspace">@drawable/ic_action_backspace</item>
        <item name="cancel">@drawable/ic_action_cancel</item>
        <item name="search">@drawable/ic_action_search</item>
        <item name="drag_handle">@drawable/ic_drag_handle</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Bright, high-contrast light palette -->
    <style name="Theme.Light" parent="Theme.AppCompat.Light">
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorPrimaryDark">#E9ECF4</item>
        <item name="colorAccent">#6D4AFF</item>
        <item name="colorControlActivated">#6D4AFF</item>
        <item name="colorControlHighlight">#226D4AFF</item>
        <item name="colorButtonNormal">#E8EAF2</item>
        <item name="android:colorAccent">#6D4AFF</item>
        <item name="android:windowBackground">#F6F7FB</item>
        <item name="android:colorBackground">#F6F7FB</item>
        <item name="android:textColorPrimary">#172033</item>
        <item name="android:textColorSecondary">#526078</item>
        <item name="android:statusBarColor">#F6F7FB</item>
        <item name="android:navigationBarColor">#F6F7FB</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="backspace">@drawable/ic_action_backspace_light</item>
        <item name="cancel">@drawable/ic_action_cancel_light</item>
        <item name="search">@drawable/ic_action_search_light</item>
        <item name="drag_handle">@drawable/ic_drag_handle_light</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Light.DarkActionBar" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorPrimaryDark">#E9ECF4</item>
        <item name="colorAccent">#6D4AFF</item>
        <item name="colorControlActivated">#6D4AFF</item>
        <item name="colorControlHighlight">#226D4AFF</item>
        <item name="colorButtonNormal">#E8EAF2</item>
        <item name="android:colorAccent">#6D4AFF</item>
        <item name="android:windowBackground">#F6F7FB</item>
        <item name="android:colorBackground">#F6F7FB</item>
        <item name="android:textColorPrimary">#172033</item>
        <item name="android:textColorSecondary">#526078</item>
        <item name="android:statusBarColor">#F6F7FB</item>
        <item name="android:navigationBarColor">#F6F7FB</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="backspace">@drawable/ic_action_backspace_light</item>
        <item name="cancel">@drawable/ic_action_cancel_light</item>
        <item name="search">@drawable/ic_action_search_light</item>
        <item name="drag_handle">@drawable/ic_drag_handle_light</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.DayNight" parent="Theme.Light" />
</resources>
